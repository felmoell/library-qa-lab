		{
			"name": "03 Data-driven",
			"description": "Run ONLY this folder with a data file: newman ... --folder '03 Data-driven' -d data/books.csv (in the Postman app: Runner > Select file). Each CSV row is one iteration.",
			"item": [
				{
					"name": "Create book from data row",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// dataRow is ignored by the API. It only makes the URL unique per CSV row, so that Allure",
									"// shows every row as its own test (same URL = same test id = shown as a retry).",
									"pm.variables.set(\"dataRow\", pm.info.iteration + 1);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// @allure.label.epic:Catalog",
									"// @allure.label.feature:\"Books API\"",
									"// @allure.label.story:\"Validation (data-driven)\"",
									"const testCase = pm.iterationData.get(\"case\");",
									"const expected = Number(pm.iterationData.get(\"expectedStatus\"));",
									"",
									"pm.test(`${testCase}: status is ${expected}`, () => pm.response.to.have.status(expected));",
									"",
									"// Clean up right away, so the next run can create the same ISBN again.",
									"// pm.sendRequest sends an extra request from a script; Newman waits for the callback.",
									"if (pm.response.code === 201) {",
									"    const id = pm.response.json().id;",
									"    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/api/books/\") + id, method: \"DELETE\" }, (err, res) => {",
									"        pm.test(\"cleanup: created book is deleted\", () => {",
									"            pm.expect(err).to.be.null;",
									"            pm.expect(res.code).to.eql(204);",
									"        });",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/books?dataRow={{dataRow}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							],
							"query": [
								{
									"key": "dataRow",
									"value": "{{dataRow}}"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isbn\": \"{{isbn}}\",\n    \"title\": \"{{title}}\",\n    \"author\": \"{{author}}\",\n    \"publishedYear\": {{publishedYear}},\n    \"copiesTotal\": {{copiesTotal}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				}
			]
		},
