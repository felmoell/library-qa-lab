		{
			"name": "01 Books CRUD",
			"description": "A chained flow: each request uses data from the previous one via collection variables (newIsbn, bookId). Run the folder in order.",
			"item": [
				{
					"name": "Create book",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Generate a random but valid ISBN-13, so this request can be sent again and again",
									"// without running into \"409 duplicate ISBN\".",
									"const digits = [9, 7, 8];",
									"for (let i = 0; i < 9; i++) digits.push(Math.floor(Math.random() * 10));",
									"const sum = digits.reduce((acc, d, i) => acc + d * (i % 2 === 0 ? 1 : 3), 0);",
									"digits.push((10 - (sum % 10)) % 10);",
									"pm.collectionVariables.set(\"newIsbn\", digits.join(\"\"));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// @allure.label.epic:Catalog",
									"// @allure.label.feature:\"Books API\"",
									"// @allure.label.story:\"Book lifecycle\"",
									"// @allure.label.severity:critical",
									"",
									"const bookSchema = {",
									"    type: \"object\",",
									"    required: [\"id\", \"isbn\", \"title\", \"author\", \"publishedYear\", \"copiesTotal\"],",
									"    additionalProperties: false,",
									"    properties: {",
									"        id: { type: \"integer\", minimum: 1 },",
									"        isbn: { type: \"string\", pattern: \"^97[89][0-9]{10}$\" },",
									"        title: { type: \"string\", minLength: 1 },",
									"        author: { type: \"string\", minLength: 1 },",
									"        publishedYear: { type: \"integer\", minimum: 1450 },",
									"        copiesTotal: { type: \"integer\", minimum: 0 }",
									"    }",
									"};",
									"",
									"pm.test(\"status is 201 Created\", () => pm.response.to.have.status(201));",
									"pm.test(\"Location header points to the new book\", () => {",
									"    pm.expect(pm.response.headers.get(\"Location\")).to.match(/\\/api\\/books\\/\\d+$/);",
									"});",
									"pm.test(\"body matches the Book JSON schema\", () => pm.response.to.have.jsonSchema(bookSchema));",
									"pm.test(\"body echoes the request\", () => {",
									"    const book = pm.response.json();",
									"    pm.expect(book.isbn).to.eql(pm.collectionVariables.get(\"newIsbn\"));",
									"    pm.expect(book.title).to.eql(\"Postman Testing\");",
									"});",
									"",
									"// Hand the id to the next requests in this folder",
									"pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/books",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isbn\": \"{{newIsbn}}\",\n    \"title\": \"Postman Testing\",\n    \"author\": \"Felix Tester\",\n    \"publishedYear\": 2024,\n    \"copiesTotal\": 3\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Get created book",
					"event": [
						{
							"listen": "test",
							"script": {
