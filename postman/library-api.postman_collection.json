								"exec": [
									"// @allure.label.epic:Catalog",
									"// @allure.label.feature:\"Books API\"",
									"// @allure.label.story:\"Book lifecycle\"",
									"pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"it is the book we created\", () => {",
									"    const book = pm.response.json();",
									"    pm.expect(book.id).to.eql(Number(pm.collectionVariables.get(\"bookId\")));",
