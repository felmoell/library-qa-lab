{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Book",
  "type": "object",
  "required": ["id", "isbn", "title", "author", "publishedYear", "copiesTotal"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "isbn": { "type": "string", "pattern": "^97[89][0-9]{10}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "publishedYear": { "type": "integer", "minimum": 1450 },
    "copiesTotal": { "type": "integer", "minimum": 0 }
  }
}
